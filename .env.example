# Offline simulation. Copy to .env; the CLI explicitly loads this file.
PAYMENT_MODE=offline
AI_MODE=deterministic
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=DEMO-MERCHANT
PAYPAL_CAPTURE_IDS=DEMO0000000000001
MAX_REFUND=100.00
SENTINEL_STATE_DIR=.state-offline

# Real mode: PAYMENT_MODE=sandbox, AI_MODE=real, a separate state directory,
# real Sandbox merchant ID, and an explicit allowlist of Sandbox capture IDs.
# Base URL includes /v1. HTTPS required except a loopback local model server.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_FORMAT=json_object
