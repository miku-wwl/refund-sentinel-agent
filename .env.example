# Offline simulation. Copy to .env; the CLI explicitly loads this file.
PAYMENT_MODE=offline
AI_MODE=deterministic
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=DEMO-MERCHANT
PAYPAL_CAPTURE_IDS=DEMO0000000000001
MAX_REFUND=100.00
SENTINEL_STATE_DIR=.state-offline

# Sandbox preflight: PAYMENT_MODE=sandbox, private client credentials, and a
# distinct .state-sandbox directory. check-auth permits an empty capture allowlist.
# Normal app startup/capture checks require the actual 13-character Business
# merchant ID and actual allowlisted capture IDs. Never use offline DEMO IDs.
# AI_MODE=deterministic is explicit test interpretation; AI_MODE=real needs
# the model configuration below. Never overwrite an existing private .env.
# Conflicting inherited environment values are rejected, not silently preferred.
# Base URL includes /v1. HTTPS required except a loopback local model server.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_FORMAT=json_object
